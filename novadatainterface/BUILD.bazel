package(default_visibility = ["//visibility:public"])

load("//:defaults.bzl", "ts_library")
load("@npm//@bazel/jasmine:index.bzl", "jasmine_node_test")
# default_pict.ts and default_rled.ts are generated from the corresponding
# .png files by scripts/pack_png.ts; they are committed so that the package
# can also be built without bazel (plain tsc / esbuild).
load("@build_bazel_rules_nodejs//:index.bzl", "pkg_npm")

ts_library(
    name = "novadatainterface",
    srcs = glob(
        ["*.ts"],
        exclude = ["*_test.ts"],
    ),
    module_name = "novadatainterface",
    deps = [
        "@npm//@types/node",
    ],
)

ts_library(
    name = "novadatainterface_test_lib",
    testonly = True,
    srcs = glob(["*_test.ts"]),
    deps = [
        ":novadatainterface",
        "@npm//@types/jasmine",
        "@npm//@types/node",
        "@npm//jasmine",
        # expressions_test.ts loads the real data through NovaParse for its
        # corpus check.
        "//novaparse",
    ],
)

jasmine_node_test(
    name = "novadatainterface_test",
    srcs = [":novadatainterface_test_lib"],
)

pkg_npm(
    name = "novadatainterface_pkg",
    package_name = "novadatainterface",
    srcs = ["package.json"],
    deps = [
        ":novadatainterface",
        "//:.gitignore",
    ],
)
